# server #
SERVER_PORT=1034
SERVER_SECRET="mySecretKey"
SERVER_ENCKEY="some 32 length key like that"
SERVER_ACCESSTOKENEXPIREDURATION=2
REQUEST_PER_SECOND=6
TRUSTED_PROXIES=["192.168.0.1", "192.168.0.2"]
EXEMPT_FROM_THROTTLE=["127.0.0.1", "192.168.0.2", "::1"]

# App #
APP_NAME=local
APP_URL=http://localhost:8019
FRONTEND_URL=http://staging.geoint.im

# Databases #
DB_HOST=localhost
DB_PORT=5433
DB_CONNECTION=pgsql
TIMEZONE=Africa/Lagos
SSLMODE=disable
USERNAME=geoint_user
PASSWORD=password
DB_NAME=geoint_db
MIGRATE=true

# Test #
TEST_DB_HOST=localhost
TEST_DB_PORT=5435
TEST_DB_CONNECTION=pgsql
TEST_TIMEZONE=Africa/Lagos
TEST_SSLMODE=disable
TEST_USERNAME=postgres
TEST_PASSWORD="password"
TEST_DB_NAME=db_name
TEST_MIGRATE=true


# IPSTACK
IPSTACK_KEY=key
IPSTACK_BASE_URL=http://api.ipstack.com
